# Puerto del servidor
PUERTO=4000

# CORS (opcional, separado por comas). Si está vacío, permite todos en dev
CORS_ORIGINS=http://localhost:5174,http://localhost:5175

# Token para rutas administrativas sensibles
ADMIN_TOKEN=

# Clave opcional para cifrar la configuracion persistida de BD.
# Si no se define, la aplicacion genera una clave local con permisos restringidos.
APP_CONFIG_SECRET=

# Autenticacion local
AUTH_COOKIE_NAME=bi_sesal_session
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_REMEMBER_DAYS=30
AUTH_SECURE_COOKIE=false
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_EMAIL=admin@local.test
AUTH_BOOTSTRAP_PASSWORD=AdminLocal123!
AUTH_RESET_TTL_MINUTES=30
AUTH_RESET_BASE_URL=http://localhost:3001/recuperar-password

# Base de datos MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=usuario
MYSQL_PASSWORD=clave
MYSQL_DATABASE=sesal_historico
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=50
MYSQL_CONNECT_TIMEOUT=10000
MYSQL_CHARSET=utf8mb4

# NODE_ENV: development | production | test
NODE_ENV=development

# Precalentamiento opcional de caché al iniciar
ENABLE_CACHE_PREWARM=false
CACHE_PREWARM_DELAY_MS=3000
CACHE_PREWARM_CONCURRENCY=1
CACHE_PREWARM_YEARS=2025,2024,2023,2022

# Jobs asíncronos para pivots pesados
PIVOT_JOB_CONCURRENCY=1
PIVOT_JOB_MAX_QUEUE=100
PIVOT_JOB_POLL_MS=3000
PIVOT_JOB_TTL_MS=21600000
